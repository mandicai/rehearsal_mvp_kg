# Copy this file to .env and fill in the values you need.
# .env is loaded automatically by server.py on startup (see segmentation/llm.py
# for details) - no key is required to run the app; without one, segment
# labeling falls back to a local heuristic instead of calling an LLM.

# --- OpenAI ---
OPENAI_API_KEY=

# --- OR OpenRouter (leave OPENAI_API_KEY blank if using this instead) ---
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: override the default model ---
# LLM_MODEL=gpt-4o-mini
