# Copy this file to .env and fill in the values you need.
# .env is loaded automatically by server.py on startup (see segmentation/llm.py
# for details) - no key is required to run the app; without one, segment
# labeling falls back to a local heuristic instead of calling an LLM.

# --- Direct OpenAI transcription (Whisper) ---
# Used only by /transcribe. The key is never sent to the browser.
OPENAI_API_KEY=

# --- OR OpenRouter for the proxy-backed writing/vision LLM calls ---
# OPENROUTER_API_KEY=

# --- Internal LLM proxy (Primary; speaks the OpenAI-compatible API) ---
# Mirror (manual fallback if Primary is ever down - swap this in as
# PROXY_BASE_URL, no automatic failover exists in this codebase):
#   https://pluto-prod-hawang-llm-proxy-2026-2-0-4000.or2.colligo.dev/
PROXY_API_KEY=
PROXY_BASE_URL=https://pluto-prod-hawang-llm-proxy-2026-0-0-4000.or2.colligo.dev/

# Optional transcription overrides (normally leave unset).
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1

# --- Optional: override the default model ---
# LLM_MODEL=gpt-4o-mini

# --- Optional: stock media search for index.html's "Find Footage" action ---
# Pexels (video) - free key at https://www.pexels.com/api/
# PEXELS_API_KEY=
# Freesound (audio/ambience) - free key at https://freesound.org/apiv2/apply/
# NOTE: Freesound's free-tier key is for non-commercial use only.
# FREESOUND_API_KEY=
