# Copy this file to .env and fill in the values you need.
# .env is loaded automatically by server.py on startup (see segmentation/llm.py
# for details) - no key is required to run the app; without one, segment
# labeling falls back to a local heuristic instead of calling an LLM.

# --- OpenAI ---
# OPENAI_API_KEY=

# --- OR OpenRouter (leave OPENAI_API_KEY blank if using this instead) ---
# OPENROUTER_API_KEY=

# --- Internal LLM proxy (Primary; speaks the OpenAI-compatible API) ---
# Mirror (manual fallback if Primary is ever down - swap this in as
# OPENAI_BASE_URL, no automatic failover exists in this codebase):
#   https://pluto-prod-hawang-llm-proxy-2026-2-0-4000.or2.colligo.dev/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://pluto-prod-hawang-llm-proxy-2026-0-0-4000.or2.colligo.dev/

# --- Optional: override the default model ---
# LLM_MODEL=gpt-4o-mini
